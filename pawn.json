{
	"user": "nolict",
	"repo": "avenue-openmp",
	"preset": "openmp",
	"entry": "gamemodes/main.pwn",
	"output": "gamemodes/main.amx",
	"dependencies": [
		"openmultiplayer/omp-stdlib",
		"pawn-lang/samp-stdlib@open.mp",
		"pawn-lang/pawn-stdlib@open.mp",
		"pawn-lang/YSI-Includes:v5.10.0006",
		"Y-Less/sscanf:v2.13.8",
		"samp-incognito/samp-streamer-plugin:v2.9.6",
		"Southclaws/zcmd",
		"Awsomedude/easyDialog:2.0"
	],
	"builds": [
		{
			"name": "dev",
			"version": "3.10.7",
			"args": [
				"-;+",
				"-(+",
				"-d3",
				"-Z+"
			],
			"includes": [
				"custom_include"
			],
			"constants": {
				"MAX_PLAYERS": "100",
				"_DEBUG": "0"
			},
			"compiler": {
				"path": "compiler"
			}
		},
		{
			"name": "live",
			"version": "3.10.10",
			"args": [
				"-;+",
				"-(+",
				"-O2",
				"-Z+"
			],
			"includes": [
				"custom_include"
			],
			"constants": {
				"MAX_PLAYERS": "100",
				"_DEBUG": "0"
			},
			"compiler": {
				"path": "compiler"
			}
		}
	]
}
